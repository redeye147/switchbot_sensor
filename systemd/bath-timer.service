[Unit]
Description=SwitchBot bath timer announcement
# bluetooth.target だけでは、起動直後にアダプタがまだ使えないことがある。
# 実際に使えるようになるまでは ExecStartPre で待つ。
After=bluetooth.target bluetooth.service sound.target network-online.target
Wants=bluetooth.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/switchbot_sensor
# .bashrc は読まれないが、システムの dist-packages が混入しないよう明示する
Environment=PYTHONPATH=
ExecStartPre=/home/pi/switchbot_sensor/wait_for_bluetooth.sh 60
ExecStart=/home/pi/switchbot_sensor/venv/bin/python /home/pi/switchbot_sensor/bath_timer.py --mac c4:88:9c:aa:ab:2f --minutes 15
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
