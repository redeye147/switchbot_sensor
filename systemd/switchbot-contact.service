[Unit]
Description=SwitchBot Contact Sensor BLE listener
After=bluetooth.target network-online.target
Wants=bluetooth.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/switchbot_sensor
# .bashrc は読まれないが、システムの dist-packages が混入しないよう明示する
Environment=PYTHONPATH=
ExecStart=/home/pi/switchbot_sensor/venv/bin/python /home/pi/switchbot_sensor/switchbot_contact.py --mac c4:88:9c:aa:ab:2f
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
