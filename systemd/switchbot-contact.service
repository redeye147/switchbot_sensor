[Unit]
Description=SwitchBot Contact Sensor BLE listener
After=bluetooth.target network-online.target
Wants=bluetooth.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/switchbot
ExecStart=/home/pi/switchbot/venv/bin/python /home/pi/switchbot/switchbot_contact.py --mac c4:88:9c:aa:ab:2f
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
