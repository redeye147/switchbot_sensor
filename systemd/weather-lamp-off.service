[Unit]
Description=Turn the weather lamp off
After=bluetooth.target bluetooth.service

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/switchbot_sensor
Environment=PYTHONPATH=
ExecStart=/home/pi/switchbot_sensor/venv/bin/python /home/pi/switchbot_sensor/weather_lamp.py --off
StandardOutput=journal
StandardError=journal
